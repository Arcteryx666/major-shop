# ================= Обязательные =================
# Токен от @BotFather. Хранится только на сервере.
BOT_TOKEN=
# Строка подключения PostgreSQL
DATABASE_URL=postgresql://major:major@localhost:5432/major_shop
# Ваш числовой Telegram ID (узнать: @userinfobot). Несколько — через запятую.
ADMIN_TELEGRAM_ID=
# Username менеджера без @ (потом можно поменять в ⚙️ Настройках бота)
MANAGER_USERNAME=
# https-адрес, где открывается магазин, например https://major-shop.onrender.com
MINI_APP_URL=
PORT=3000
NODE_ENV=production

# ================= Бот =================
# webhook — для сервера (Render), polling — для локального запуска
BOT_MODE=webhook
# Случайная строка от 16 символов: openssl rand -hex 32
WEBHOOK_SECRET=
# Публичный https-адрес сервера. Если не задан — берётся MINI_APP_URL
PUBLIC_URL=

# ================= Процессы =================
# all — API + бот + планировщик в одном процессе (рекомендуется)
# api — только HTTP и webhook; worker — только планировщик (и polling)
ROLE=all

# ================= Необязательные =================
# Нужен, только если Mini App раздаётся с другого домена
CORS_ORIGINS=
# Срок жизни подписи Telegram initData, секунд (по умолчанию сутки)
INIT_DATA_MAX_AGE=86400
# Путь к собранному фронтенду (по умолчанию ищется apps/web/dist)
WEB_DIST_DIR=
